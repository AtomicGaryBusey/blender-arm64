# Single source of truth for top-level pins (sourced by build.sh and container scripts).
BLENDER_VERSION=5.2.2
BLENDER_GIT_URL=https://projects.blender.org/blender/blender.git
BLENDER_COMMIT=d13f752e3b9c4f8c261cda552b1021f8bcc0382c   # tag v5.2.2 (lightweight)

OPTIX_GIT_URL=https://github.com/NVIDIA/optix-dev.git
OPTIX_COMMIT=fff65c2a7c592f1ea5f1661ad7d2381cf965f9bd      # tag v9.0.0 (OptiX 9.1 needs R590; host is R580)

# CUDA 13.0.3 devel image (nvcc 13.0.88), arm64 manifest digest.
BASE_IMAGE=nvcr.io/nvidia/cuda@sha256:2396393dc8a031a6faf810894ec8e40c8d80e2a1177cfda0c2bf81acac9aa240   # 13.0.3-devel-ubuntu24.04, arm64 manifest

CYCLES_CUDA_ARCH=sm_120   # SASS for sm_120 runs on GB10 (sm_121); Cycles falls back sm_121 -> sm_120
OIDN_CUDA_SM_LIST=120
