+           -e "s/OIDN_CUDA_SM80_FLAGS 80 90 100 120)/OIDN_CUDA_SM80_FLAGS ${OIDN_CUDA_SM_LIST})/"
+    ${BUILD_DIR}/openimagedenoise/src/external_openimagedenoise/devices/cuda/CMakeLists.txt
+  )
+endif()
