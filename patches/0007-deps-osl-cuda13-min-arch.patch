diff --git a/build_files/build_environment/cmake/osl.cmake b/build_files/build_environment/cmake/osl.cmake
index d5e4ef8e..04643bf0 100644
--- a/build_files/build_environment/cmake/osl.cmake
+++ b/build_files/build_environment/cmake/osl.cmake
@@ -60,9 +60,21 @@ set(OSL_EXTRA_ARGS
 if(NOT (APPLE OR BLENDER_PLATFORM_WINDOWS_ARM))
   list(APPEND OSL_EXTRA_ARGS
     -DOSL_USE_OPTIX=ON
-    -DCUDA_TARGET_ARCH=sm_50
+    # blender-gb10: CUDA 13 removed sm_50..sm_70; sm_75 is the oldest target it supports.
+    -DCUDA_TARGET_ARCH=sm_75
     -DCUDA_TOOLKIT_ROOT_DIR=${CUDAToolkit_ROOT}
   )
+  # blender-gb10: CUDA 13 no longer ships texture_fetch_functions.h, which LLVM 20's
+  # __clang_cuda_runtime_wrapper.h includes unconditionally. OSL does not use texture
+  # references (it already defines __CLANG_CUDA_TEXTURE_INTRINSICS_H__ for CUDA >= 12), so an
+  # empty header in a build-local overlay include dir is sufficient. Never touches the toolkit.
+  set(OSL_CUDA13_OVERLAY ${BUILD_DIR}/osl/cuda13_overlay)
+  file(WRITE ${OSL_CUDA13_OVERLAY}/texture_fetch_functions.h
+    "/* blender-gb10: empty stand-in, removed from CUDA 13 (see osl.cmake). */\n")
+  set(OSL_CUDA13_PATCH_COMMAND &&
+    sed -i "s|CUDA_TEXREF_FIX}|CUDA_TEXREF_FIX} -idirafter ${OSL_CUDA13_OVERLAY}|"
+      ${BUILD_DIR}/osl/src/external_osl/src/cmake/cuda_macros.cmake
+  )
 endif()
 
 ExternalProject_Add(external_osl
@@ -83,6 +95,7 @@ ExternalProject_Add(external_osl
     ${PATCH_CMD} -p 1 -d
       ${BUILD_DIR}/osl/src/external_osl <
       ${PATCH_DIR}/osl_relative_inc_cmake.diff
+    ${OSL_CUDA13_PATCH_COMMAND}
 
   CMAKE_ARGS
     -DCMAKE_INSTALL_PREFIX=${LIBDIR}/osl
