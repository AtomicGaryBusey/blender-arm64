diff --git a/build_files/build_environment/cmake/python_site_packages.cmake b/build_files/build_environment/cmake/python_site_packages.cmake
index cbce2127..59ecf920 100644
--- a/build_files/build_environment/cmake/python_site_packages.cmake
+++ b/build_files/build_environment/cmake/python_site_packages.cmake
@@ -25,6 +25,22 @@ file(WRITE ${PIP_CONSTRAINT_FILE}
 "setuptools-scm==${SETUPTOOLS_SCM_VERSION}\n"
 )
 
+# blender-gb10: optionally install the same pinned versions offline from a local,
+# hash-locked wheelhouse (pip --require-hashes) instead of resolving against PyPI.
+set(PYTHON_SITE_PACKAGES_WHEELHOUSE "" CACHE PATH "Local wheel directory for site-packages (offline)")
+set(PYTHON_SITE_PACKAGES_REQUIREMENTS "" CACHE FILEPATH "Hash-locked requirements file for the wheelhouse")
+if(PYTHON_SITE_PACKAGES_WHEELHOUSE)
+  ExternalProject_Add(external_python_site_packages
+    DOWNLOAD_COMMAND ""
+    CONFIGURE_COMMAND ${PIP_CONFIGURE_COMMAND}
+    BUILD_COMMAND ""
+    PREFIX ${BUILD_DIR}/site_packages
+    INSTALL_COMMAND
+      ${PYTHON_BINARY} -m pip install --no-cache-dir --no-index --no-deps --require-hashes
+        --find-links ${PYTHON_SITE_PACKAGES_WHEELHOUSE}
+        -r ${PYTHON_SITE_PACKAGES_REQUIREMENTS}
+  )
+else()
 ExternalProject_Add(external_python_site_packages
   DOWNLOAD_COMMAND ""
   CONFIGURE_COMMAND ${PIP_CONFIGURE_COMMAND}
@@ -56,6 +72,7 @@ ExternalProject_Add(external_python_site_packages
       tomli-w==${TOMLI_W_VERSION}
       --no-binary :all:
 )
+endif()
 
 add_dependencies(
   external_python_site_packages
