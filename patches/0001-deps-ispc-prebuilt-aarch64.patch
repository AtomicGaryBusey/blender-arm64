+# blender-gb10: official prebuilt ISPC release for Linux aarch64 (same version as above).
+set(ISPC_PREBUILT_URI https://github.com/ispc/ispc/releases/download/${ISPC_VERSION}/ispc-${ISPC_VERSION}-linux.aarch64.tar.gz)
+set(ISPC_PREBUILT_HASH 509399c399ec162d746889458a10cc13797a1aed1c0164b2bd3faddf7d023f13)
+set(ISPC_PREBUILT_HASH_TYPE SHA256)
+set(ISPC_PREBUILT_FILE ispc-${ISPC_VERSION}-linux.aarch64.tar.gz)
 set(ISPC_FILE ispc-${ISPC_VERSION}.tar.gz)
 set(ISPC_DEPSBUILDTIMEONLY "Blender ships the produced artifact, but doesn't ship/link with any binary")
 
