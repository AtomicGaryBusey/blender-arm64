diff --git a/build_files/build_environment/cmake/ispc.cmake b/build_files/build_environment/cmake/ispc.cmake
index c93b22ae..fbb318c8 100644
--- a/build_files/build_environment/cmake/ispc.cmake
+++ b/build_files/build_environment/cmake/ispc.cmake
@@ -2,6 +2,25 @@
 #
 # SPDX-License-Identifier: GPL-2.0-or-later
 
+# blender-gb10: on Linux aarch64 use the official ISPC release binary (same version as
+# ISPC_VERSION, sha256-pinned in versions.cmake) instead of building ISPC against a
+# locally built LLVM. ISPC is only a build tool (OIDN CPU kernels); this removes LLVM
+# from the required dependency set.
+if(BLENDER_PLATFORM_ARM AND UNIX AND NOT APPLE)
+  ExternalProject_Add(external_ispc
+    URL file://${PACKAGE_DIR}/${ISPC_PREBUILT_FILE}
+    DOWNLOAD_DIR ${DOWNLOAD_DIR}
+    URL_HASH ${ISPC_PREBUILT_HASH_TYPE}=${ISPC_PREBUILT_HASH}
+    PREFIX ${BUILD_DIR}/ispc
+    CONFIGURE_COMMAND ""
+    BUILD_COMMAND ""
+    INSTALL_COMMAND ${CMAKE_COMMAND} -E copy_directory
+      ${BUILD_DIR}/ispc/src/external_ispc/bin ${LIBDIR}/ispc/bin
+    INSTALL_DIR ${LIBDIR}/ispc
+  )
+  return()
+endif()
+
 if(WIN32)
   set(ISPC_EXTRA_ARGS_WIN
     -DFLEX_EXECUTABLE=${LIBDIR}/flexbison/win_flex.exe
